# Environment for templates/wordpress.compose.yml.
#
# You normally do NOT need to set anything here. Every variable has a working
# default, so an empty Environment tab deploys the standard site. Set a variable
# in Dokploy's Environment tab only when you want to change one site.
#
# Full explanation of every value: docs/wiki/WORDPRESS-STACK-TUNING.md

# ── Credentials — leave blank ────────────────────────────────────────────────
# Dokploy auto-generates these per service on deploy. Never set them by hand.
SERVICE_USER_WORDPRESS=
SERVICE_PASSWORD_WORDPRESS=
SERVICE_PASSWORD_ROOT=

# ── WordPress container ──────────────────────────────────────────────────────
# WP_MEM_LIMIT=384m
# WP_MEMSWAP_LIMIT=768m          # RAM + swap COMBINED, must be >= WP_MEM_LIMIT
# WP_MEM_RESERVATION=128m
# WP_CPUS=1.0
# WP_PIDS_LIMIT=128

# Apache concurrency. WP_MAX_WORKERS must stay <= DB_MAX_CONNECTIONS.
# WP_MAX_WORKERS=8
# WP_START_SERVERS=2
# WP_MIN_SPARE=2
# WP_MAX_SPARE=4
# WP_MAX_REQUESTS_PER_CHILD=500
# WP_TIMEOUT=60
# WP_KEEPALIVE_TIMEOUT=5

# ── Database container ───────────────────────────────────────────────────────
# DB_MEM_LIMIT=288m
# DB_MEMSWAP_LIMIT=416m          # 288m limit + 128m swap cushion for spikes
# DB_MEM_RESERVATION=96m
# DB_CPUS=0.75
# DB_PIDS_LIMIT=128

# Raise DB_MEM_LIMIT with DB_BUFFER_POOL — see the formula in the tuning doc.
# DB_BUFFER_POOL=128M
# DB_MAX_CONNECTIONS=20

# ── Logging (both containers) ────────────────────────────────────────────────
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
